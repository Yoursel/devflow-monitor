<UserControl x:Class="DevFlowMonitor.Wpf.View.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModel="clr-namespace:DevFlowMonitor.Wpf.ViewModel"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModel:AnalyticsViewModel}">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="4 2 4 16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Margin="0" Text="Аналитика"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Сравнение надёжности и длительности запусков за выбранный период"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Width="140"
                        Margin="16 0 0 0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Style="{StaticResource MainButton}"
                        Command="{Binding RefreshCommand}"
                        Content="Обновить"/>
            </Grid>

            <ProgressBar Grid.Row="1" Style="{StaticResource LoadingBar}" Margin="4 0 4 12"/>

            <StackPanel Grid.Row="2" Margin="4 0 4 12">
                <WrapPanel>
                    <StackPanel Width="170" Margin="0 0 10 10">
                        <TextBlock Text="Начало периода" Style="{StaticResource FormFieldLabel}"/>
                        <DatePicker SelectedDate="{Binding PeriodStartDate}"
                                    IsEnabled="{Binding ArePeriodDatesEnabled}"
                                    Style="{StaticResource FormDatePicker}"/>
                    </StackPanel>
                    <StackPanel Width="170" Margin="0 0 10 10">
                        <TextBlock Text="Окончание периода" Style="{StaticResource FormFieldLabel}"/>
                        <DatePicker SelectedDate="{Binding PeriodEndDate}"
                                    IsEnabled="{Binding ArePeriodDatesEnabled}"
                                    Style="{StaticResource FormDatePicker}"/>
                    </StackPanel>
                    <Button Width="150"
                            Margin="0 22 10 10"
                            Command="{Binding ToggleAllTimeCommand}"
                            Content="{Binding AllTimeButtonText}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAllTime}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SuccessAccentBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessAccentBlockBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <StackPanel Width="205" Margin="0 0 10 10">
                        <TextBlock Text="Репозиторий" Style="{StaticResource FormFieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Repositories}"
                                  SelectedItem="{Binding SelectedRepository}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource FormComboBox}"
                                  Height="36"/>
                    </StackPanel>
                </WrapPanel>
                <WrapPanel>
                    <StackPanel Width="180" Margin="0 0 10 10">
                        <TextBlock Text="Пайплайн" Style="{StaticResource FormFieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Workflows}"
                                  SelectedItem="{Binding SelectedWorkflow}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource FormComboBox}"
                                  Height="36"/>
                    </StackPanel>
                    <StackPanel Width="160" Margin="0 0 10 10">
                        <TextBlock Text="Статус" Style="{StaticResource FormFieldLabel}"/>
                        <ComboBox ItemsSource="{Binding AvailableStatuses}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  SelectedValue="{Binding SelectedStatus}"
                                  Style="{StaticResource FormComboBox}"
                                  Height="36"/>
                    </StackPanel>
                    <Button Width="115"
                            Margin="0 22 10 10"
                            Style="{StaticResource MainButton}"
                            Command="{Binding ApplyFiltersCommand}"
                            Content="Применить"/>
                    <Button Width="105"
                            Margin="0 22 0 10"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ResetFiltersCommand}"
                            Content="Сбросить"/>
                </WrapPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="4 0 4 16">
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StatusBanner}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedForeground}"/>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Сводные показатели"/>
                    <StackPanel Margin="0 0 0 12">
                        <UniformGrid Columns="4">
                        <Border Style="{StaticResource AnalyticsMetricCard}">
                            <StackPanel Style="{StaticResource AnalyticsMetricContent}"><TextBlock Style="{StaticResource AnalyticsMetricText}" Text="ЗАПУСКОВ" Foreground="{StaticResource MutedForeground}"/><TextBlock Style="{StaticResource AnalyticsMetricText}" Text="{Binding Metrics.TotalRuns, TargetNullValue=—}" FontSize="22"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource AnalyticsMetricCard}">
                            <StackPanel Style="{StaticResource AnalyticsMetricContent}"><TextBlock Style="{StaticResource AnalyticsMetricText}" Text="УСПЕШНОСТЬ" Foreground="{StaticResource MutedForeground}"/><TextBlock Style="{StaticResource AnalyticsMetricText}" FontSize="20"><TextBlock.Text><MultiBinding StringFormat="{}{0} из {1} · {2:F1}%"><Binding Path="Metrics.SuccessfulRuns"/><Binding Path="Metrics.TotalRuns"/><Binding Path="Metrics.SuccessRate"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
                        </Border>
                        <Border Style="{StaticResource AnalyticsMetricCard}">
                            <StackPanel Style="{StaticResource AnalyticsMetricContent}"><TextBlock Style="{StaticResource AnalyticsMetricText}" Text="ОШИБКИ" Foreground="{StaticResource MutedForeground}"/><TextBlock Style="{StaticResource AnalyticsMetricText}" FontSize="20"><TextBlock.Text><MultiBinding StringFormat="{}{0} из {1} · {2:F1}%"><Binding Path="Metrics.FailedRuns"/><Binding Path="Metrics.TotalRuns"/><Binding Path="Metrics.FailureRate"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
                        </Border>
                        <Border Style="{StaticResource AnalyticsMetricCard}">
                            <StackPanel Style="{StaticResource AnalyticsMetricContent}"><TextBlock Style="{StaticResource AnalyticsMetricText}" Text="ИЗМЕНЕНИЕ УСПЕШНОСТИ" Foreground="{StaticResource MutedForeground}"/><TextBlock Style="{StaticResource AnalyticsMetricText}" Text="{Binding Metrics.SuccessRateChange, StringFormat={}{0:+0.0;-0.0;0.0} п.п., TargetNullValue=—}" FontSize="22"/></StackPanel>
                        </Border>
                        </UniformGrid>
                        <UniformGrid Columns="3">
                        <Border Style="{StaticResource AnalyticsMetricCard}">
                            <StackPanel Style="{StaticResource AnalyticsMetricContent}"><TextBlock Style="{StaticResource AnalyticsMetricText}" Text="СРЕДНЕЕ ВРЕМЯ" Foreground="{StaticResource MutedForeground}"/><TextBlock Style="{StaticResource AnalyticsMetricText}" Text="{Binding Metrics.AverageDurationSeconds, StringFormat={}{0:F0} сек., TargetNullValue=—}" FontSize="20"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource AnalyticsMetricCard}">
                            <StackPanel Style="{StaticResource AnalyticsMetricContent}"><TextBlock Style="{StaticResource AnalyticsMetricText}" Text="МАКС. ВРЕМЯ" Foreground="{StaticResource MutedForeground}"/><TextBlock Style="{StaticResource AnalyticsMetricText}" Text="{Binding Metrics.MaximumDurationSeconds, StringFormat={}{0:F0} сек., TargetNullValue=—}" FontSize="20"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource AnalyticsMetricCard}">
                            <StackPanel Style="{StaticResource AnalyticsMetricContent}"><TextBlock Style="{StaticResource AnalyticsMetricText}" Text="ЗАПУСКИ С ПОВТОРНОЙ ПОПЫТКОЙ" TextWrapping="Wrap" Foreground="{StaticResource MutedForeground}"/><TextBlock Style="{StaticResource AnalyticsMetricText}" FontSize="20"><TextBlock.Text><MultiBinding StringFormat="{}{0} из {1} · {2:F1}%"><Binding Path="Metrics.RetriedRuns"/><Binding Path="Metrics.TotalRuns"/><Binding Path="Metrics.RetryRate"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
                        </Border>
                        </UniformGrid>
                    </StackPanel>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Динамика запусков"/>
                    <Border Style="{StaticResource FormInputBorder}" Padding="12" Margin="0 0 0 20">
                        <lvc:CartesianChart Height="330"
                                            Background="{StaticResource CardBackground}"
                                            LegendPosition="Top"
                                            TooltipPosition="Top"
                                            AnimationsSpeed="0:0:0.25">
                            <lvc:CartesianChart.Series>
                                <lvc:SeriesCollection>
                                    <lvc:XamlStackedColumnSeries SeriesName="Успешные"
                                                                 Values="{Binding SuccessfulRunValues}"
                                                                 Fill="{lvc:SolidColorPaint Color='#22c55e'}"
                                                                 Stroke="{x:Null}"
                                                                 MaxBarWidth="24"/>
                                    <lvc:XamlStackedColumnSeries SeriesName="Ошибки"
                                                                 Values="{Binding FailedRunValues}"
                                                                 Fill="{lvc:SolidColorPaint Color='#ef4444'}"
                                                                 Stroke="{x:Null}"
                                                                 MaxBarWidth="24"/>
                                    <lvc:XamlStackedColumnSeries SeriesName="Остальные"
                                                                 Values="{Binding OtherRunValues}"
                                                                 Fill="{lvc:SolidColorPaint Color='#C8BFA8'}"
                                                                 Stroke="{x:Null}"
                                                                 MaxBarWidth="24"/>
                                    <lvc:XamlLineSeries SeriesName="Средняя длительность, сек."
                                                        Values="{Binding AverageDurationValues}"
                                                        ScalesYAt="1"
                                                        Fill="{x:Null}"
                                                        Stroke="{lvc:SolidColorPaint Color='#6B8FB3'}"
                                                        GeometryFill="{lvc:SolidColorPaint Color='#B8D4F0'}"
                                                        GeometryStroke="{lvc:SolidColorPaint Color='#6B8FB3'}"
                                                        GeometrySize="7"
                                                        LineSmoothness="0.35"/>
                                </lvc:SeriesCollection>
                            </lvc:CartesianChart.Series>
                            <lvc:CartesianChart.XAxes>
                                <lvc:AxesCollection>
                                    <lvc:XamlAxis Labels="{Binding TrendLabels}"
                                                  TextSize="11"
                                                  ShowSeparatorLines="False"
                                                  LabelsPaint="{lvc:SolidColorPaint Color='#2D2E27'}"/>
                                </lvc:AxesCollection>
                            </lvc:CartesianChart.XAxes>
                            <lvc:CartesianChart.YAxes>
                                <lvc:AxesCollection>
                                    <lvc:XamlAxis AxisName="Запуски"
                                                  MinLimit="0"
                                                  MinStep="1"
                                                  TextSize="11"
                                                  LabelsPaint="{lvc:SolidColorPaint Color='#2D2E27'}"
                                                  NamePaint="{lvc:SolidColorPaint Color='#2D2E27'}"
                                                  SeparatorsPaint="{lvc:SolidColorPaint Color='#E4DBC8'}"/>
                                    <lvc:XamlAxis AxisName="Среднее время, сек."
                                                  Position="End"
                                                  MinLimit="0"
                                                  TextSize="11"
                                                  LabelsPaint="{lvc:SolidColorPaint Color='#6B8FB3'}"
                                                  NamePaint="{lvc:SolidColorPaint Color='#6B8FB3'}"
                                                  ShowSeparatorLines="False"/>
                                </lvc:AxesCollection>
                            </lvc:CartesianChart.YAxes>
                        </lvc:CartesianChart>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Сравнение"/>
                    <StackPanel Margin="0 0 0 20">
                        <TextBlock Text="Репозитории" Margin="0 0 0 8" FontSize="14"/>
                        <ListView ItemsSource="{Binding RepositoryComparisons}"
                                  Height="220"
                                  Margin="0 0 0 16"
                                  Style="{StaticResource PipelineListStyle}"
                                  ItemContainerStyle="{StaticResource PipelineRowStyle}">
                            <ListView.View><GridView ColumnHeaderContainerStyle="{StaticResource PipelineColumnHeaderStyle}">
                                <GridViewColumn Header="РЕПОЗИТОРИЙ" Width="240" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="ВСЕГО ЗАПУСКОВ" Width="150" DisplayMemberBinding="{Binding TotalRuns}"/>
                                <GridViewColumn Header="УСПЕХ" Width="90" DisplayMemberBinding="{Binding SuccessRate, StringFormat={}{0:F1}%}"/>
                                <GridViewColumn Header="ОШИБКИ" Width="90" DisplayMemberBinding="{Binding FailureRate, StringFormat={}{0:F1}%}"/>
                                <GridViewColumn Header="СР. СЕК." Width="100" DisplayMemberBinding="{Binding AverageDurationSeconds, StringFormat={}{0:F0}}"/>
                                <GridViewColumn Header="С ПОВТОРНОЙ ПОПЫТКОЙ" Width="190" DisplayMemberBinding="{Binding RetryRate, StringFormat={}{0:F1}%}"/>
                            </GridView></ListView.View>
                        </ListView>
                        <TextBlock Text="Пайплайны" Margin="0 0 0 8" FontSize="14"/>
                        <ListView ItemsSource="{Binding WorkflowComparisons}"
                                  Height="220"
                                  Style="{StaticResource PipelineListStyle}"
                                  ItemContainerStyle="{StaticResource PipelineRowStyle}">
                            <ListView.View><GridView ColumnHeaderContainerStyle="{StaticResource PipelineColumnHeaderStyle}">
                                <GridViewColumn Header="ПАЙПЛАЙН" Width="240" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="ВСЕГО ЗАПУСКОВ" Width="150" DisplayMemberBinding="{Binding TotalRuns}"/>
                                <GridViewColumn Header="УСПЕХ" Width="90" DisplayMemberBinding="{Binding SuccessRate, StringFormat={}{0:F1}%}"/>
                                <GridViewColumn Header="ОШИБКИ" Width="90" DisplayMemberBinding="{Binding FailureRate, StringFormat={}{0:F1}%}"/>
                                <GridViewColumn Header="СР. СЕК." Width="100" DisplayMemberBinding="{Binding AverageDurationSeconds, StringFormat={}{0:F0}}"/>
                                <GridViewColumn Header="С ПОВТОРНОЙ ПОПЫТКОЙ" Width="190" DisplayMemberBinding="{Binding RetryRate, StringFormat={}{0:F1}%}"/>
                            </GridView></ListView.View>
                        </ListView>
                    </StackPanel>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Статистика сбоев по job"/>
                    <ListView ItemsSource="{Binding JobFailures}"
                              Height="210"
                              Margin="0 0 0 20"
                              Style="{StaticResource PipelineListStyle}"
                              ItemContainerStyle="{StaticResource PipelineRowStyle}">
                        <ListView.View><GridView ColumnHeaderContainerStyle="{StaticResource PipelineColumnHeaderStyle}">
                            <GridViewColumn Header="ПАЙПЛАЙН / JOB" Width="390" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="ЗАПУСКОВ" Width="110" DisplayMemberBinding="{Binding TotalExecutions}"/>
                            <GridViewColumn Header="СБОЕВ" Width="90" DisplayMemberBinding="{Binding FailedExecutions}"/>
                            <GridViewColumn Header="ДОЛЯ СБОЕВ" Width="130" DisplayMemberBinding="{Binding FailureRate, StringFormat={}{0:F1}%}"/>
                        </GridView></ListView.View>
                    </ListView>

                </StackPanel>
            </ScrollViewer>
    </Grid>
</UserControl>
