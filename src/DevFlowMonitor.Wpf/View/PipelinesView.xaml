<UserControl x:Class="DevFlowMonitor.Wpf.View.PipelinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModel="clr-namespace:DevFlowMonitor.Wpf.ViewModel"
             xmlns:dto="clr-namespace:DevFlowMonitor.Wpf.Dto"
             xmlns:contracts="clr-namespace:DevFlowMonitor.Contracts;assembly=DevFlowMonitor.Contracts"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModel:PipelinesListViewModel}">
    <Grid Style="{StaticResource PageRoot}">
        <Grid x:Name="ListPanel">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedPipeline}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="4 2 4 16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Margin="0" Text="Запуски"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Поиск пайплайнов и просмотр подробной истории запусков"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Width="140"
                        Margin="16 0 0 0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Style="{StaticResource MainButton}"
                        Command="{Binding RefreshCommand}">
                    <WrapPanel HorizontalAlignment="Center">
                        <Image Source="{StaticResource RefreshIcon}"/>
                        <TextBlock Text="Обновить"/>
                    </WrapPanel>
                </Button>
            </Grid>

            <ProgressBar Grid.Row="1" Style="{StaticResource LoadingBar}" Margin="4 0 4 12"/>

            <WrapPanel Grid.Row="2" Margin="4 0 4 10">
                    <StackPanel Width="220" Margin="0 0 10 10">
                        <TextBlock Text="Поиск" Style="{StaticResource FormFieldLabel}"/>
                        <Border Style="{StaticResource FormInputBorder}" Height="38">
                            <TextBox Style="{StaticResource FormInput}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Название пайплайна или репозитория"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Width="160" Margin="0 0 10 10">
                        <TextBlock Text="Ветка" Style="{StaticResource FormFieldLabel}"/>
                        <Border Style="{StaticResource FormInputBorder}" Height="38">
                            <TextBox Style="{StaticResource FormInput}"
                                     Text="{Binding BranchFilter, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Например: main"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Width="180" Margin="0 0 10 10">
                        <TextBlock Text="Статус" Style="{StaticResource FormFieldLabel}"/>
                        <ComboBox Height="38"
                                  Style="{StaticResource FormComboBox}"
                                  ItemsSource="{Binding AvailableStatuses}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedStatus}"/>
                    </StackPanel>
                    <Button Width="110"
                            Margin="0 22 10 10"
                            Style="{StaticResource MainButton}"
                            Command="{Binding ApplyFiltersCommand}"
                            Content="Применить"/>
                    <Button Width="100"
                            Margin="0 22 0 10"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearFiltersCommand}"
                            Content="Сбросить"/>
            </WrapPanel>

            <Border Grid.Row="3" Margin="4 0 4 12">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatusBanner}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedForeground}"
                           FontSize="12"/>
            </Border>

            <Grid Grid.Row="4" Margin="4 0 4 0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Pipelines}" HorizontalAlignment="Stretch"/>
                </ScrollViewer>
                <Border Padding="20" Background="{StaticResource CardBackground}" IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Pipelines.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="15" Text="Ничего не найдено"/>
                        <TextBlock Margin="0 6 0 0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedForeground}"
                                   Text="Измените фильтры или синхронизируйте GitHub-аккаунт"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="5" Margin="4 12 4 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Width="38" Margin="0 0 6 0" ToolTip="Первая страница"
                            AutomationProperties.Name="Первая страница"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding Pagination.GoToFirstPageCommand}">
                        <Image Source="{StaticResource FirstPageIcon}" Margin="0"/>
                    </Button>
                    <Button Width="38" Margin="0 0 6 0" ToolTip="Предыдущая страница"
                            AutomationProperties.Name="Предыдущая страница"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding Pagination.GoToPreviousPageCommand}">
                        <Image Source="{StaticResource PreviousPageIcon}" Margin="0"/>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Pagination.VisiblePages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type dto:PageInfo}">
                                <Button Width="38"
                                        Margin="0 0 6 0"
                                        Content="{Binding Number}"
                                        Command="{Binding DataContext.Pagination.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Number}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SuccessAccentBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessAccentTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Width="38" Margin="0 0 6 0" ToolTip="Следующая страница"
                            AutomationProperties.Name="Следующая страница"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding Pagination.GoToNextPageCommand}">
                        <Image Source="{StaticResource NextPageIcon}" Margin="0"/>
                    </Button>
                    <Button Width="38" Margin="0" ToolTip="Последняя страница"
                            AutomationProperties.Name="Последняя страница"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding Pagination.GoToLastPageCommand}">
                        <Image Source="{StaticResource LastPageIcon}" Margin="0"/>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Margin="16 0 0 0"
                           HorizontalAlignment="Right"
                           Text="{Binding Pagination.ItemRangeInfo}"
                           Foreground="{StaticResource MutedForeground}"
                           FontSize="12"/>
            </Grid>
        </Grid>

        <Grid Background="#F0EBD8">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedPipeline}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="4 2 4 16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Width="110"
                        Margin="0 0 16 0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CloseHistoryCommand}"
                        Content="← Назад"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource PageTitle}" Margin="0" Text="История запусков"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="{Binding SelectedPipeline.PipelineName}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <ProgressBar Grid.Row="1" Style="{StaticResource LoadingBar}" Margin="4 0 4 12"/>
            <ListView Grid.Row="2"
                      Margin="4 0 4 0"
                      ItemsSource="{Binding SelectedPipeline.Runs}"
                      Style="{StaticResource PipelineListStyle}"
                      ItemContainerStyle="{StaticResource PipelineRowStyle}">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource PipelineColumnHeaderStyle}">
                        <GridViewColumn Header="СТАТУС" Width="120" CellTemplate="{StaticResource StatusBadgeTemplate}"/>
                        <GridViewColumn Header="ЗАПУСК" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RunNumber, StringFormat=\# {0}}" FontWeight="Bold"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="НАЗВАНИЕ" Width="280" DisplayMemberBinding="{Binding Title}"/>
                        <GridViewColumn Header="ВЕТКА" Width="180" DisplayMemberBinding="{Binding Branch}"/>
                        <GridViewColumn Header="ПОВТОРНАЯ ПОПЫТКА" Width="210">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="—"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RerunOutcome}" Value="{x:Static contracts:RerunOutcome.SucceededAfterRetry}">
                                                        <Setter Property="Text" Value="Успех после повтора"/>
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessAccentBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RerunOutcome}" Value="{x:Static contracts:RerunOutcome.StillFailingAfterRetry}">
                                                        <Setter Property="Text" Value="Ошибка после повтора"/>
                                                        <Setter Property="Foreground" Value="{StaticResource FailedAccentBlockBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RerunOutcome}" Value="{x:Static contracts:RerunOutcome.RetriedWithOtherOutcome}">
                                                        <Setter Property="Text" Value="Повтор: иной результат"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="ВРЕМЯ" Width="170">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StartedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
